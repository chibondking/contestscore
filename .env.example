HTTP_PORT=3000
# 0.0.0.0 for a LAN/Pi install reached directly by hostname. Set to
# 127.0.0.1 when running behind a reverse proxy (nginx, etc.) so the app
# itself is never reachable on the public interface.
HTTP_HOST=0.0.0.0
UDP_RADIO_PORT=12060
UDP_CONTACT_PORT=12061
UDP_SCORE_PORT=12062
DB_PATH=./data/qsos.db
LOOKUP_PROVIDER=none
QRZ_USERNAME=
QRZ_PASSWORD=

# Required to call DELETE /api/db on any deployment reachable outside your
# own LAN -- leave unset for a purely local install (the endpoint then only
# checks X-Confirm: yes, as before). Generate with: openssl rand -hex 32
# Do NOT commit the real value.
CONTESTSCORE_API_TOKEN=
