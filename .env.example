HTTP_PORT=3000
# 0.0.0.0 for a LAN/Pi install reached directly by hostname. Set to
# 127.0.0.1 when running behind a reverse proxy (nginx, etc.) so the app
# itself is never reachable on the public interface.
HTTP_HOST=0.0.0.0
UDP_RADIO_PORT=12060
UDP_CONTACT_PORT=12061
UDP_SCORE_PORT=12062
DB_PATH=./data/qsos.db
LOOKUP_PROVIDER=none
QRZ_USERNAME=
QRZ_PASSWORD=

# Required to call DELETE /api/db on any deployment reachable outside your
# own LAN -- leave unset for a purely local install (the endpoint then only
# checks X-Confirm: yes, as before). Also required for the /api/ingest/*
# routes the ContestPulse bridge posts to (see contestpulse/) and for
# POST /api/analyze (uploading a Cabrillo/ADIF log to the analyzer) -- those
# routes have no LAN-only fallback and refuse everything (503) if this is
# unset. Reading a saved analysis (GET /api/analyze/<id>) stays public.
# Generate with: openssl rand -hex 32. Do NOT commit the real value.
CONTESTSCORE_API_TOKEN=

# Log analyzer retention (docs/ANALYZER.md). Each upload keeps only the
# newest ANALYZE_KEEP analyses and drops anything older than
# ANALYZE_TTL_DAYS; 0 disables that bound. ANALYZE_MAX_BYTES caps a single
# upload. Defaults shown.
ANALYZE_KEEP=200
ANALYZE_TTL_DAYS=365
ANALYZE_MAX_BYTES=5242880

# Thresholds for the realtime/stale/offline indicator derived from
# ContestPulse's heartbeats. Defaults (15s/30s) assume ContestPulse's own
# default 10s heartbeat interval -- adjust both sides together if you change
# heartbeat_interval_seconds in contestpulse/config.json.
BRIDGE_STALE_AFTER_MS=15000
BRIDGE_OFFLINE_AFTER_MS=30000
